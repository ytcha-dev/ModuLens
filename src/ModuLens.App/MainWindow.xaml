<Window x:Class="ModuLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ModuLens"
        Width="1180"
        Height="760"
        MinWidth="760"
        MinHeight="480"
        Background="#F3F4F6"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18,12"
                Background="#111827">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="ModuLens" />
                    <TextBlock Foreground="#9CA3AF"
                               FontSize="11"
                               Text="Editable module explorer" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Margin="24,0"
                           VerticalAlignment="Center"
                           Foreground="#D1D5DB"
                           Text="{Binding FilePath, TargetNullValue=No file selected}"
                           TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="2"
                        MinWidth="118"
                        Padding="14,8"
                        VerticalAlignment="Center"
                        Click="OpenFile_Click"
                        Content="Open JavaScript…" />

                <Button x:Name="SaveButton"
                        Grid.Column="3"
                        MinWidth="82"
                        Margin="8,0,0,0"
                        Padding="14,8"
                        VerticalAlignment="Center"
                        Click="SaveFile_Click"
                        Content="Save"
                        IsEnabled="{Binding CanSave}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Margin="4,0,4,10"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Text="Modules" />

                    <ListBox Grid.Row="1"
                             BorderThickness="0"
                             ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                             DisplayMemberPath="Name"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="16,9"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Text="{Binding SelectedSection.Name, TargetNullValue=Select a module}" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="#6B7280"
                                       Text="{Binding SelectedRangeSummary}" />
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="ModuleEditor"
                             Grid.Row="1"
                             Padding="16"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             Background="#0F172A"
                             BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="13"
                             Foreground="#E5E7EB"
                             HorizontalScrollBarVisibility="Auto"
                             IsEnabled="{Binding HasSelectedSection}"
                             Text="{Binding SelectedSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="14,5"
                Background="#E5E7EB">
            <TextBlock FontSize="11"
                       Foreground="#4B5563"
                       Text="{Binding StatusMessage}" />
        </Border>
    </Grid>
</Window>
