<Window x:Class="ModuLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ModuLens"
        Width="1180"
        Height="760"
        MinWidth="760"
        MinHeight="480"
        Background="#F3F4F6"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18,12"
                Background="#111827">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="ModuLens" />
                    <TextBlock Foreground="#9CA3AF"
                               FontSize="11"
                               Text="Module editor · Git status · Side-by-side diff" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Margin="24,0"
                           VerticalAlignment="Center"
                           Foreground="#D1D5DB"
                           Text="{Binding FilePath, TargetNullValue=No file selected}"
                           TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="2"
                        MinWidth="118"
                        Padding="14,8"
                        VerticalAlignment="Center"
                        Click="OpenFile_Click"
                        Content="Open JavaScript…" />

                <Button x:Name="SaveButton"
                        Grid.Column="3"
                        MinWidth="82"
                        Margin="8,0,0,0"
                        Padding="14,8"
                        VerticalAlignment="Center"
                        Click="SaveFile_Click"
                        Content="Save"
                        IsEnabled="{Binding CanSave}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Margin="4,0,4,10"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Text="Modules" />

                    <ListBox Grid.Row="1"
                             BorderThickness="0"
                             ItemsSource="{Binding Modules}"
                             SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,2,0"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Text="{Binding GitStatusLabel}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#6B7280" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GitStatusLabel}"
                                                                 Value="modified">
                                                        <Setter Property="Foreground" Value="#B45309" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GitStatusLabel}"
                                                                 Value="added">
                                                        <Setter Property="Foreground" Value="#047857" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GitStatusLabel}"
                                                                 Value="removed">
                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="16,9"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Text="{Binding SelectedModule.Name, TargetNullValue=Select a module}" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="#6B7280"
                                       Text="{Binding SelectedRangeSummary}" />
                        </StackPanel>
                    </Border>

                    <TabControl x:Name="ModuleDetailTabs"
                                Grid.Row="1"
                                Background="#0F172A"
                                BorderThickness="0"
                                SelectedIndex="{Binding SelectedDetailTabIndex, Mode=TwoWay}">
                        <TabItem Header="Current">
                            <TextBox x:Name="ModuleEditor"
                                     Padding="16"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     Background="#0F172A"
                                     BorderThickness="0"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="13"
                                     Foreground="#E5E7EB"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsEnabled="{Binding HasSelectedSection}"
                                     Text="{Binding SelectedSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </TabItem>

                        <TabItem x:Name="DiffTab"
                                 Header="Diff"
                                 IsEnabled="{Binding CanShowDiff}">
                            <Grid Background="#0F172A">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Padding="12,8"
                                        Background="#111827"
                                        BorderBrush="#374151"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F3F4F6"
                                                       Text="{Binding DiffSummary}" />
                                            <Button Grid.Column="1"
                                                    MinWidth="72"
                                                    Padding="8,2"
                                                    Click="PreviousChangedModule_Click"
                                                    Content="Previous"
                                                    IsEnabled="{Binding CanSelectPreviousChangedModule}" />
                                            <Button Grid.Column="2"
                                                    MinWidth="60"
                                                    Margin="6,0,0,0"
                                                    Padding="8,2"
                                                    Click="NextChangedModule_Click"
                                                    Content="Next"
                                                    IsEnabled="{Binding CanSelectNextChangedModule}" />
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="11"
                                                       Foreground="#9CA3AF"
                                                       Text="{Binding HeadDiffRangeSummary}" />
                                            <TextBlock Grid.Column="1"
                                                       FontSize="11"
                                                       Foreground="#9CA3AF"
                                                       Text="{Binding WorkingDiffRangeSummary}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer Grid.Row="1"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled">
                                    <Grid Width="849" Background="#1F2937">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="380" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="380" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.ColumnSpan="2"
                                                   Margin="10,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#D1D5DB"
                                                   Text="HEAD" />
                                        <Border Grid.Column="2" Background="#4B5563" />
                                        <TextBlock Grid.Column="3"
                                                   Grid.ColumnSpan="2"
                                                   Margin="10,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#D1D5DB"
                                                   Text="WORKING TREE" />
                                    </Grid>
                                </ScrollViewer>

                                <ListBox x:Name="ModuleDiffList"
                                         Grid.Row="2"
                                         Background="#0F172A"
                                         BorderThickness="0"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="12"
                                         ItemsSource="{Binding SelectedDiffLines}"
                                         ScrollViewer.CanContentScroll="False"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="BorderThickness" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="849" MinHeight="22">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="380" />
                                                    <ColumnDefinition Width="1" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="380" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.ColumnSpan="2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#0F172A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding KindLabel}" Value="modified">
                                                                    <Setter Property="Background" Value="#3B3219" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding KindLabel}" Value="removed">
                                                                    <Setter Property="Background" Value="#3F1D24" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <Border Grid.Column="2" Background="#374151" />
                                                <Border Grid.Column="3" Grid.ColumnSpan="2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#0F172A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding KindLabel}" Value="modified">
                                                                    <Setter Property="Background" Value="#3B3219" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding KindLabel}" Value="added">
                                                                    <Setter Property="Background" Value="#12372A" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <TextBlock Margin="0,2,8,2"
                                                           HorizontalAlignment="Right"
                                                           Foreground="#6B7280"
                                                           Text="{Binding HeadLineNumber}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,2"
                                                           Foreground="#E5E7EB"
                                                           Text="{Binding HeadText}" />
                                                <TextBlock Grid.Column="3"
                                                           Margin="0,2,8,2"
                                                           HorizontalAlignment="Right"
                                                           Foreground="#6B7280"
                                                           Text="{Binding WorkingLineNumber}" />
                                                <TextBlock Grid.Column="4"
                                                           Margin="8,2"
                                                           Foreground="#E5E7EB"
                                                           Text="{Binding WorkingText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="14,5"
                Background="#E5E7EB">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="11"
                           Foreground="#4B5563"
                           Text="{Binding StatusMessage}" />
                <TextBlock Grid.Column="1"
                           Margin="20,0,0,0"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Foreground="#4B5563"
                           Text="{Binding GitStatusMessage}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
